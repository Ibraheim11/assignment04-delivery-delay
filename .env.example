# Copy to .env (ignored by Git). Linux: replace with the output of id -u.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
# Set unique local development secrets; use URL-safe alphanumeric DB passwords.
POSTGRES_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_JWT_SECRET=
# Generate with cryptography.fernet.Fernet.generate_key().decode().
AIRFLOW_FERNET_KEY=
